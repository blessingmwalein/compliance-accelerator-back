// Prisma schema for fca-backend. Models start in Phase 2a; Phase 0 only proves the toolchain.
//
// - The connection URL is NOT here: Prisma 7 reads it from prisma.config.ts (DIRECT_URL, the
//   non-pooled Neon URL, for migrations). Runtime queries use the pooled DATABASE_URL through
//   the @prisma/adapter-pg driver adapter (see src/prisma/prisma.service.ts).
// - The generated client is TypeScript source under src/generated (git-ignored; regenerated by
//   `npm run db:generate`, which also runs on postinstall).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------
// Phase 2a: tenancy foundation. Conventions (see .claude/skills/database-and-tenancy):
// - snake_case tables via @@map, UUIDv7 ids, timestamptz instants, `version` for optimistic locking.
// - Every tenant-owned table has a non-null organisation_id and composite FKs; global tables are
//   listed in src/database/global-tables.ts (checked by the catalogue test).
// ---------------------------------------------------------------------------------------------

/**
 * The six fixed system roles (owner decision; DPO is a designated contact, not a role).
 */
enum MembershipRole {
  COMPANY_OWNER
  COMPANY_ADMIN
  COMPLIANCE_MANAGER
  COURSE_ADMINISTRATOR
  STANDARD_USER
  READ_ONLY

  @@map("membership_role")
}

enum MembershipStatus {
  ACTIVE
  DEACTIVATED

  @@map("membership_status")
}

enum AuditActorType {
  USER
  SYSTEM

  @@map("audit_actor_type")
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE

  @@map("audit_outcome")
}

/**
 * The tenant root: its own id IS the tenant id (listed in TENANT_ROOT_TABLES).
 */
model Organisation {
  id                 String    @id @default(uuid(7)) @db.Uuid
  name               String
  /// IANA zone (e.g. Africa/Harare). Required, no default: deadline arithmetic must never run on a guessed zone.
  timezone           String
  /// Company Settings (Phase 3). Everything below is optional: a blank value is "not provided", never a default.
  /// How the organisation is shown to its members; changing it needs company.branding (Owner).
  displayName        String?   @map("display_name")
  legalName          String?   @map("legal_name")
  registrationNumber String?   @map("registration_number")
  sector             String?
  country            String?
  address            String?
  /// The designated Data Protection Officer contact. NOT a role and not necessarily a user (may be external).
  dpoName            String?   @map("dpo_name")
  dpoEmail           String?   @map("dpo_email")
  dpoPhone           String?   @map("dpo_phone")
  /// Logo metadata; the file itself lives in storage under logoKey (never served from a public URL).
  logoKey            String?   @map("logo_key")
  logoContentType    String?   @map("logo_content_type")
  logoSize           Int?      @map("logo_size")
  logoSha256         String?   @map("logo_sha256")
  logoUpdatedAt      DateTime? @map("logo_updated_at") @db.Timestamptz
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships            Membership[]
  invitations            Invitation[]
  regulatorContacts      RegulatorContact[]
  businessUnits          BusinessUnit[]
  organisationFrameworks OrganisationFramework[]
  entitlement            OrganisationEntitlement?
  governanceAreas        GovernanceArea[]
  organisationMappings   OrganisationMapping[]
  auditEvents            AuditEvent[]
  idempotency            IdempotencyKey[]

  assessments           Assessment[]
  assessmentItems       AssessmentItem[]
  itemPriorities        ItemPriority[]
  assessmentPolicy      AssessmentPolicy?
  remediationTasks      RemediationTask[]
  remediationTaskEvents RemediationTaskEvent[]
  evidence              Evidence[]
  itemEvidenceLinks     AssessmentItemEvidence[]
  taskEvidenceLinks     RemediationTaskEvidence[]
  reports               Report[]

  @@map("organisations")
}

/**
 * A person. Global (not tenant-owned): one user may belong to several organisations.
 */
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Stored lower-case; uniqueness is enforced on the lower-cased value (CHECK in the migration).
  email           String    @unique
  fullName        String    @map("full_name")
  isActive        Boolean   @default(true) @map("is_active")
  /// argon2id PHC string. Null = no password set (reserved for SSO or invitation flows). Never logged or returned.
  passwordHash    String?   @map("password_hash")
  /// Null until the address was proven with the emailed token; login is refused until then.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  /// Outside the six roles (ADR-0005): may call /platform/* only and never passes the organisation guard.
  /// Granted with `npm run platform-admin -- grant <email>` (owner credentials), never through the API.
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships          Membership[]
  auditEvents          AuditEvent[]
  sessions             Session[]
  authTokens           AuthToken[]
  securityEvents       SecurityEvent[]
  entitlementsAssigned OrganisationEntitlement[] @relation("EntitlementAssignedBy")
  invitationsSent      Invitation[]              @relation("InvitationInvitedBy")
  invitationsAccepted  Invitation[]              @relation("InvitationAcceptedBy")

  assessmentsCreated   Assessment[]              @relation("AssessmentCreatedBy")
  assessmentsSubmitted Assessment[]              @relation("AssessmentSubmittedBy")
  assessmentsApproved  Assessment[]              @relation("AssessmentApprovedBy")
  prioritiesAdjusted   ItemPriority[]            @relation("PriorityAdjustedBy")
  tasksCreated         RemediationTask[]         @relation("TaskCreatedBy")
  tasksCompleted       RemediationTask[]         @relation("TaskCompletedBy")
  tasksVerified        RemediationTask[]         @relation("TaskVerifiedBy")
  taskEvents           RemediationTaskEvent[]    @relation("TaskEventActor")
  evidenceUploaded     Evidence[]                @relation("EvidenceUploadedBy")
  itemEvidenceLinked   AssessmentItemEvidence[]  @relation("ItemEvidenceLinkedBy")
  taskEvidenceLinked   RemediationTaskEvidence[] @relation("TaskEvidenceLinkedBy")
  reportsRequested     Report[]                  @relation("ReportRequestedBy")

  @@map("users")
}

model Membership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organisation        Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user                User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessUnitsHeaded BusinessUnit[]    @relation("BusinessUnitHead")
  itemsOwned          AssessmentItem[]  @relation("ItemOwner")
  tasksAssigned       RemediationTask[] @relation("TaskAssignee")

  @@unique([organisationId, id])
  @@unique([organisationId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Append-only. The database rejects UPDATE and DELETE (trigger in the migration, plus REVOKE for the
/// runtime role in prisma/sql/runtime-role.sql). Written in the same transaction as the change it records.
model AuditEvent {
  id             String         @id @default(uuid(7)) @db.Uuid
  organisationId String         @map("organisation_id") @db.Uuid
  /// Server clock (DB default), never a client-supplied time.
  occurredAt     DateTime       @default(now()) @map("occurred_at") @db.Timestamptz
  actorType      AuditActorType @map("actor_type")
  /// Null for SYSTEM actors (jobs). A foreign key without cascade: users are deactivated, never deleted.
  actorUserId    String?        @map("actor_user_id") @db.Uuid
  /// Typed catalogue key such as `business_unit.created` (src/audit/audit-actions.ts).
  action         String
  entityType     String         @map("entity_type")
  entityId       String?        @map("entity_id")
  /// Human label at the time (name/code), so the trail stays readable after a rename or removal.
  entityLabel    String?        @map("entity_label")
  outcome        AuditOutcome   @default(SUCCESS)
  requestId      String?        @map("request_id")
  /// Before/after values with sensitive fields redacted by the writer (never raw personal data).
  changes        Json?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organisationId, occurredAt(sort: Desc)])
  @@index([organisationId, entityType, entityId])
  @@index([organisationId, actorUserId, occurredAt(sort: Desc)])
  @@index([organisationId, action, occurredAt(sort: Desc)])
  @@map("audit_events")
}

/// Replays the stored response for a retried create (`Idempotency-Key` header), per organisation and endpoint.
model IdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  key            String
  /// "POST /organisations/:organisationId/business-units" (the route template, not the concrete URL).
  endpoint       String
  /// SHA-256 of the request body: the same key with a different body is a client error, not a replay.
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt      DateTime @map("expires_at") @db.Timestamptz

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------------------------
// Phase 2b: authentication, security events, jobs outbox and email deliveries.
// None of these tables is tenant-owned (no organisation_id): they belong to a user or to the
// system. They are listed in GLOBAL_TABLES (src/database/catalogue.ts) with the reason.
// ---------------------------------------------------------------------------------------------

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("auth_token_purpose")
}

enum SessionRevokedReason {
  LOGOUT
  REFRESH_REUSE
  PASSWORD_RESET
  EXPIRED

  @@map("session_revoked_reason")
}

enum JobStatus {
  QUEUED
  LEASED
  SUCCEEDED
  DEAD

  @@map("job_status")
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  SUPPRESSED

  @@map("email_status")
}

/// One login. Its id is also the refresh-token FAMILY id and the `sid` claim of its access tokens.
model Session {
  id            String                @id @default(uuid(7)) @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt    DateTime              @default(now()) @map("last_used_at") @db.Timestamptz
  /// Absolute lifetime: a session cannot be refreshed past this instant.
  expiresAt     DateTime              @map("expires_at") @db.Timestamptz
  revokedAt     DateTime?             @map("revoked_at") @db.Timestamptz
  revokedReason SessionRevokedReason? @map("revoked_reason")
  /// Truncated client description for the "your sessions" screen; not used for decisions.
  userAgent     String?               @map("user_agent")
  /// Keyed hash of the client IP (never the address itself).
  ipHash        String?               @map("ip_hash")

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Rotated on every refresh. Presenting a token whose `used_at` is set means it was stolen or replayed:
/// the whole session (family) is revoked.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// SHA-256 (hex) of the opaque 32-byte token; the token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// Email-verification and password-reset tokens: random 32 bytes, stored hashed, purpose-typed,
/// single-use, expiring, consumed by a POST (never a GET).
model AuthToken {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose    AuthTokenPurpose
  tokenHash  String           @unique @map("token_hash")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// Counters for lockout and progressive delay. Keyed on keyed hashes so attempts against addresses
/// that do not exist are counted too (no enumeration) without storing those addresses.
model LoginAttempt {
  id          String   @id @default(uuid(7)) @db.Uuid
  accountHash String   @map("account_hash")
  ipHash      String?  @map("ip_hash")
  succeeded   Boolean
  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamptz

  @@index([accountHash, attemptedAt(sort: Desc)])
  @@index([ipHash, attemptedAt(sort: Desc)])
  @@map("login_attempts")
}

/// Append-only (trigger in the migration + REVOKE in prisma/sql/runtime-role.sql). Events that belong to
/// no organisation: registration, login, refresh reuse, password reset. Tenant events go to audit_events.
model SecurityEvent {
  id          String       @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime     @default(now()) @map("occurred_at") @db.Timestamptz
  /// Typed catalogue key such as `auth.login_failed` (src/security-events/security-event-types.ts).
  eventType   String       @map("event_type")
  outcome     AuditOutcome @default(SUCCESS)
  userId      String?      @map("user_id") @db.Uuid
  /// Keyed hash of the email address for events about accounts that may not exist.
  subjectHash String?      @map("subject_hash")
  ipHash      String?      @map("ip_hash")
  requestId   String?      @map("request_id")
  metadata    Json?

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([occurredAt(sort: Desc)])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([eventType, occurredAt(sort: Desc)])
  @@map("security_events")
}

/// Transactional outbox + lease runner (ADR-0006). Enqueued in the same transaction as the change that
/// causes it; claimed with FOR UPDATE SKIP LOCKED; at-least-once, so handlers are idempotent.
model Job {
  id          String    @id @default(uuid(7)) @db.Uuid
  type        String
  /// Ids only: no personal data and no secrets.
  payload     Json
  runAt       DateTime  @default(now()) @map("run_at") @db.Timestamptz
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  leaseUntil  DateTime? @map("lease_until") @db.Timestamptz
  leasedBy    String?   @map("leased_by")
  /// Deterministic, so a retried request cannot enqueue the same work twice.
  dedupeKey   String    @unique @map("dedupe_key")
  /// Sanitised: never contains payloads, addresses or tokens.
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz

  @@map("jobs")
}

/// One row per attempt to send an email, keyed on the ADDRESS (invitees and the DPO contact need not be users).
model EmailDelivery {
  id                String      @id @default(uuid(7)) @db.Uuid
  toAddress         String      @map("to_address")
  template          String
  status            EmailStatus @default(QUEUED)
  providerMessageId String?     @map("provider_message_id")
  attempts          Int         @default(0)
  lastError         String?     @map("last_error")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz

  @@index([toAddress, createdAt(sort: Desc)])
  @@index([status])
  @@map("email_deliveries")
}

// ---------------------------------------------------------------------------------------------
// Phase 2c: invitations (tenant-owned). The membership itself already exists (Phase 2a).
// ---------------------------------------------------------------------------------------------

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED

  @@map("invitation_status")
}

/**
 * An offer to join an organisation with a role, sent to an email ADDRESS (the invitee need not have an
 * account yet). The emailed token is created by the email job at send time; only its SHA-256 is stored.
 * Expiry is computed against the clock (a PENDING row past `expires_at` is "expired" without a write).
 */
model Invitation {
  id               String           @id @default(uuid(7)) @db.Uuid
  organisationId   String           @map("organisation_id") @db.Uuid
  /// Lower-case (CHECK in the migration).
  email            String
  role             MembershipRole
  status           InvitationStatus @default(PENDING)
  /// SHA-256 (hex) of the emailed token. Null until the first email was sent; replaced on every (re)send,
  /// so only the newest link works. Looked up globally at acceptance (the invitee has no organisation yet).
  tokenHash        String?          @unique @map("token_hash")
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz
  sendCount        Int              @default(0) @map("send_count")
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, status, createdAt(sort: Desc)])
  @@index([organisationId, email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------------------------
// Phase 3: setup modules (Company Settings, Business Units, frameworks, plans).
// ---------------------------------------------------------------------------------------------

/// A regulator or supervisory authority the organisation reports to. Typed in by the organisation: no
/// regulator, deadline or contact is ever assumed by the platform.
model RegulatorContact {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  authorityName  String   @map("authority_name")
  jurisdiction   String?
  contactName    String?  @map("contact_name")
  email          String?
  phone          String?
  notes          String?
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, authorityName])
  @@map("regulator_contacts")
}

/// An organisational unit (department, subsidiary, site). Flat in v1. Archived, never deleted: later records
/// (assessments, risks) will point at it, so history stays readable. Name and code are unique per organisation
/// among NON-archived units (partial unique indexes in the migration).
model BusinessUnit {
  id               String    @id @default(uuid(7)) @db.Uuid
  organisationId   String    @map("organisation_id") @db.Uuid
  name             String
  /// Short optional identifier chosen by the organisation (for example "FIN").
  code             String?
  description      String?
  /// The member who heads the unit (not free text: it can later receive notifications). Same organisation, by composite FK.
  headMembershipId String?   @map("head_membership_id") @db.Uuid
  /// Data sensitivity classification, 1 (Public) to 5 (Critical); null = not classified, never a default.
  sensitivity      Int?      @db.SmallInt
  employeeCount    Int?      @map("employee_count")
  /// Optional parent unit (same organisation, by composite FK).
  parentId         String?   @map("parent_id") @db.Uuid
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organisation     Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  head             Membership?       @relation("BusinessUnitHead", fields: [organisationId, headMembershipId], references: [organisationId, id], onDelete: Restrict)
  parent           BusinessUnit?     @relation("BusinessUnitParent", fields: [organisationId, parentId], references: [organisationId, id], onDelete: Restrict)
  children         BusinessUnit[]    @relation("BusinessUnitParent")
  assessmentItems  AssessmentItem[]
  remediationTasks RemediationTask[]

  @@unique([organisationId, id])
  @@index([organisationId, archivedAt])
  @@index([organisationId, headMembershipId])
  @@index([organisationId, parentId])
  @@map("business_units")
}

/// The catalogue of frameworks an organisation can declare applicable. GLOBAL reference data: identifiers only
/// (code, name, jurisdiction). It holds NO legal text; requirement content and its provenance arrive in Phase 4.
model Framework {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Stable short code shown in the UI and used in mappings (CDPA, POPIA, GDPR, ...).
  code         String   @unique
  name         String
  jurisdiction String
  /// LAW, STANDARD or FRAMEWORK: how the source is described, not a claim about its legal force.
  kind         String
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organisationFrameworks OrganisationFramework[]
  versions               FrameworkVersion[]

  assessmentItems  AssessmentItem[]
  remediationTasks RemediationTask[]

  @@map("frameworks")
}

/// Which frameworks an organisation declared applicable. Removing one keeps the row (removedAt): changing the
/// set never deletes history, and adding it again reactivates the same row.
model OrganisationFramework {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  frameworkId    String    @map("framework_id") @db.Uuid
  addedAt        DateTime  @default(now()) @map("added_at") @db.Timestamptz
  removedAt      DateTime? @map("removed_at") @db.Timestamptz
  version        Int       @default(1)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  framework    Framework    @relation(fields: [frameworkId], references: [id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@unique([organisationId, frameworkId])
  @@map("organisation_frameworks")
}

/// Subscription plans. GLOBAL, platform-managed. The seeded rows are PLACEHOLDERS taken from the legacy UI
/// (limits pending commercial confirmation). isVisible only decides whether a plan is offered: hiding a plan
/// never touches an organisation that already has it (entitlements are snapshots, below).
model Plan {
  id            String   @id @default(uuid(7)) @db.Uuid
  code          String   @unique
  name          String
  description   String?
  /// Null = unlimited.
  maxUsers      Int?     @map("max_users")
  apiAccess     Boolean  @default(false) @map("api_access")
  isVisible     Boolean  @default(true) @map("is_visible")
  isPlaceholder Boolean  @default(true) @map("is_placeholder")
  sortOrder     Int      @default(0) @map("sort_order")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  entitlements OrganisationEntitlement[]

  @@map("plans")
}

/// What one organisation is entitled to, copied from its plan when the plan was assigned. A later edit or
/// hiding of the plan never changes it. No row = no plan assigned = no limits enforced (never "zero").
model OrganisationEntitlement {
  id               String   @id @default(uuid(7)) @db.Uuid
  organisationId   String   @unique @map("organisation_id") @db.Uuid
  planId           String   @map("plan_id") @db.Uuid
  planCode         String   @map("plan_code")
  planName         String   @map("plan_name")
  maxUsers         Int?     @map("max_users")
  apiAccess        Boolean  @map("api_access")
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.Timestamptz
  assignedByUserId String   @map("assigned_by_user_id") @db.Uuid
  version          Int      @default(1)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  assignedBy   User         @relation("EntitlementAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@map("organisation_entitlements")
}

// ---------------------------------------------------------------------------------------------
// Phase 4: framework content and compliance mapping (ADR-0009, skill compliance-frameworks).
// FRAMEWORK_VERSIONS, REQUIREMENTS and MAPPING_PACK_ENTRIES are GLOBAL reference data written only by the
// owner-run loader (`npm run frameworks:load`) from packs that a named person has verified; the runtime role
// can only read them. Nothing here is typed from memory: every version carries its source, retrieval time and
// content hashes, and a version that has been verified can no longer change (database trigger).
// ---------------------------------------------------------------------------------------------

enum FrameworkVersionStatus {
  DRAFT
  VERIFIED
  PUBLISHED
  SUPERSEDED
}

/// How the source may be reused: decides what the platform may store (ISO text is paid: identifiers only).
enum LicenceClass {
  PUBLIC_DOMAIN
  OPEN_REUSE
  LICENSED_TEXT
  USER_SUPPLIED
}

/// What `title` / `description` of a requirement are: copied word for word from the source, our paraphrase, or
/// only an identifier. The operative text of a law is NOT stored in any case.
enum TextSource {
  VERBATIM
  PARAPHRASE
  REFERENCE_ONLY
}

enum MappingRelationship {
  EXACT
  PARTIAL
  RELATED
}

enum MappingOrigin {
  SEED
  USER
}

enum MappingReviewStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
}

/// One edition of a framework (for example "NIST CSF 2.0"). Only VERIFIED or later versions are ever loaded.
model FrameworkVersion {
  id            String                 @id @default(uuid(7)) @db.Uuid
  frameworkId   String                 @map("framework_id") @db.Uuid
  label         String
  status        FrameworkVersionStatus @default(DRAFT)
  licenceClass  LicenceClass           @map("licence_class")
  effectiveFrom DateTime?              @map("effective_from") @db.Date
  sourceUrl     String                 @map("source_url")
  citation      String
  retrievedAt   DateTime               @map("retrieved_at") @db.Timestamptz
  /// "sha256:..." of the stored source file the content was extracted from.
  sourceHash    String                 @map("source_hash")
  /// "sha256:..." of the canonical requirement and mapping content that the verifier reviewed.
  contentHash   String                 @map("content_hash")
  verifiedBy    String?                @map("verified_by")
  verifiedAt    DateTime?              @map("verified_at") @db.Timestamptz
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  framework    Framework     @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  requirements Requirement[]

  @@unique([frameworkId, label])
  @@index([frameworkId, status])
  @@map("framework_versions")
}

/// A node of a framework version's tree (function > category > subcategory, chapter > article, ...).
model Requirement {
  id                 String     @id @default(uuid(7)) @db.Uuid
  frameworkVersionId String     @map("framework_version_id") @db.Uuid
  /// The parent node in the SAME version (composite foreign key).
  parentId           String?    @map("parent_id") @db.Uuid
  /// The source's own identifier, for example "GV.OC-01" or "Art. 33".
  ref                String
  /// function, category, subcategory, chapter, article, ... (descriptive, set by the pack).
  kind               String
  title              String
  description        String?
  textSource         TextSource @map("text_source")
  sortOrder          Int        @map("sort_order")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz

  frameworkVersion         FrameworkVersion      @relation(fields: [frameworkVersionId], references: [id], onDelete: Restrict)
  parent                   Requirement?          @relation("RequirementTree", fields: [frameworkVersionId, parentId], references: [frameworkVersionId, id], onDelete: Restrict)
  children                 Requirement[]         @relation("RequirementTree")
  mappingsFrom             MappingPackEntry[]    @relation("PackEntryFrom")
  mappingsTo               MappingPackEntry[]    @relation("PackEntryTo")
  organisationMappingsFrom OrganisationMapping[] @relation("OrganisationMappingFrom")
  organisationMappingsTo   OrganisationMapping[] @relation("OrganisationMappingTo")
  assessmentItems          AssessmentItem[]
  remediationTasks         RemediationTask[]

  @@unique([frameworkVersionId, id])
  @@unique([frameworkVersionId, ref])
  @@index([frameworkVersionId, parentId, sortOrder])
  @@map("requirements")
}

/// A default cross-framework mapping that comes from a CITED crosswalk or a named legal reviewer. No row exists
/// until such a source is supplied: an empty pack is valid, a fabricated one is not.
model MappingPackEntry {
  id                String              @id @default(uuid(7)) @db.Uuid
  fromRequirementId String              @map("from_requirement_id") @db.Uuid
  toRequirementId   String              @map("to_requirement_id") @db.Uuid
  relationship      MappingRelationship
  /// The crosswalk (title, publisher, location) or the named reviewer this entry comes from. Never empty.
  citation          String
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz

  fromRequirement      Requirement           @relation("PackEntryFrom", fields: [fromRequirementId], references: [id], onDelete: Restrict)
  toRequirement        Requirement           @relation("PackEntryTo", fields: [toRequirementId], references: [id], onDelete: Restrict)
  organisationMappings OrganisationMapping[]

  @@unique([fromRequirementId, toRequirementId])
  @@map("mapping_pack_entries")
}

/// An organisation's own list of governance areas (topics such as "Data subject rights"). Free labels chosen by
/// the organisation: no legal content. Archived, never deleted. Phase 5 assessments will point at these.
model GovernanceArea {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  name           String
  description    String?
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organisation     Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  mappings         OrganisationMapping[]
  assessmentItems  AssessmentItem[]
  remediationTasks RemediationTask[]

  @@unique([organisationId, id])
  @@index([organisationId, archivedAt])
  @@map("governance_areas")
}

/// An organisation's mapping between two requirements of DIFFERENT frameworks, optionally filed under a
/// governance area. SEED rows are copies of verified pack entries (never overwritten, never resurrected once
/// archived: unique on source_entry_id); USER rows carry a mandatory rationale. Informative only: a mapping
/// never establishes legal equivalence.
model OrganisationMapping {
  id                String              @id @default(uuid(7)) @db.Uuid
  organisationId    String              @map("organisation_id") @db.Uuid
  areaId            String?             @map("area_id") @db.Uuid
  fromRequirementId String              @map("from_requirement_id") @db.Uuid
  toRequirementId   String              @map("to_requirement_id") @db.Uuid
  relationship      MappingRelationship
  origin            MappingOrigin
  sourceEntryId     String?             @map("source_entry_id") @db.Uuid
  rationale         String?
  reference         String?
  reviewStatus      MappingReviewStatus @default(DRAFT) @map("review_status")
  archivedAt        DateTime?           @map("archived_at") @db.Timestamptz
  version           Int                 @default(1)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  organisation    Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  area            GovernanceArea?   @relation(fields: [organisationId, areaId], references: [organisationId, id], onDelete: Restrict)
  fromRequirement Requirement       @relation("OrganisationMappingFrom", fields: [fromRequirementId], references: [id], onDelete: Restrict)
  toRequirement   Requirement       @relation("OrganisationMappingTo", fields: [toRequirementId], references: [id], onDelete: Restrict)
  sourceEntry     MappingPackEntry? @relation(fields: [sourceEntryId], references: [id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, areaId])
  @@index([organisationId, archivedAt])
  @@index([fromRequirementId])
  @@index([toRequirementId])
  @@map("organisation_mappings")
}

// ---------------------------------------------------------------------------------------------
// Phase 5: governance assessment, scoring, priority matrix, remediation, evidence core, report core.
// Conventions as before: UUIDv7 ids, timestamptz, version for optimistic locking, composite foreign keys
// to tenant tables, row-level security on every table (migration). Approved assessments are immutable:
// database triggers (migration) reject any change to them or their items.
// ---------------------------------------------------------------------------------------------

enum AssessmentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SUPERSEDED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  VERIFIED
  CANCELLED
}

enum TaskEventKind {
  COMMENT
  STATUS_CHANGE
  ASSIGNMENT
}

enum ReportStatus {
  PENDING
  READY
  FAILED
}

/// One assessment cycle: a set of items scored under a named methodology. DRAFT -> IN_REVIEW -> APPROVED
/// (immutable) -> SUPERSEDED when a revision is approved. The bands in force are SNAPSHOT here, so an approved
/// assessment reads the same forever even if the organisation changes its bands later.
model Assessment {
  id                  String           @id @default(uuid(7)) @db.Uuid
  organisationId      String           @map("organisation_id") @db.Uuid
  title               String
  description         String?
  status              AssessmentStatus @default(DRAFT)
  methodologyId       String           @map("methodology_id")
  methodologyVersion  Int              @map("methodology_version")
  /// The exposure bands used to score this assessment: [{ key, label, min, max }].
  exposureBands       Json             @map("exposure_bands")
  createdByUserId     String           @map("created_by_user_id") @db.Uuid
  submittedAt         DateTime?        @map("submitted_at") @db.Timestamptz
  submittedByUserId   String?          @map("submitted_by_user_id") @db.Uuid
  approvedAt          DateTime?        @map("approved_at") @db.Timestamptz
  approvedByUserId    String?          @map("approved_by_user_id") @db.Uuid
  /// The reviewer's comment on the last return or approval.
  reviewComment       String?          @map("review_comment")
  /// The approved assessment this one revises (it becomes SUPERSEDED when this one is approved).
  revisesAssessmentId String?          @map("revises_assessment_id") @db.Uuid
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  createdBy    User             @relation("AssessmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  submittedBy  User?            @relation("AssessmentSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  approvedBy   User?            @relation("AssessmentApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  revises      Assessment?      @relation("AssessmentRevision", fields: [organisationId, revisesAssessmentId], references: [organisationId, id], onDelete: Restrict)
  revisions    Assessment[]     @relation("AssessmentRevision")
  items        AssessmentItem[]
  reports      Report[]

  @@unique([organisationId, id])
  @@index([organisationId, status])
  @@map("assessments")
}

/// One assessed subject: a governance area and/or a framework requirement, optionally for one business unit and
/// framework. All ratings are nullable: NULL means NOT ASSESSED and is never replaced by a default. gap, exposure
/// and risk_level are derived by the service from the ratings and the assessment's band snapshot and stored so
/// that an approved item reads the same forever.
model AssessmentItem {
  id                String     @id @default(uuid(7)) @db.Uuid
  organisationId    String     @map("organisation_id") @db.Uuid
  assessmentId      String     @map("assessment_id") @db.Uuid
  governanceAreaId  String?    @map("governance_area_id") @db.Uuid
  requirementId     String?    @map("requirement_id") @db.Uuid
  /// Null = the whole organisation (shown as such, not a magic value).
  businessUnitId    String?    @map("business_unit_id") @db.Uuid
  frameworkId       String?    @map("framework_id") @db.Uuid
  currentMaturity   Int?       @map("current_maturity") @db.SmallInt
  targetMaturity    Int?       @map("target_maturity") @db.SmallInt
  sensitivity       Int?       @db.SmallInt
  severity          Int?       @db.SmallInt
  likelihood        Int?       @db.SmallInt
  gap               Int?       @db.SmallInt
  exposure          Int?       @db.SmallInt
  riskLevel         RiskLevel? @map("risk_level")
  rationale         String?
  findings          String?
  ownerMembershipId String?    @map("owner_membership_id") @db.Uuid
  lastReviewDate    DateTime?  @map("last_review_date") @db.Date
  nextReviewDate    DateTime?  @map("next_review_date") @db.Date
  version           Int        @default(1)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  organisation   Organisation             @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  assessment     Assessment               @relation(fields: [organisationId, assessmentId], references: [organisationId, id], onDelete: Restrict)
  governanceArea GovernanceArea?          @relation(fields: [organisationId, governanceAreaId], references: [organisationId, id], onDelete: Restrict)
  requirement    Requirement?             @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  businessUnit   BusinessUnit?            @relation(fields: [organisationId, businessUnitId], references: [organisationId, id], onDelete: Restrict)
  framework      Framework?               @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  owner          Membership?              @relation("ItemOwner", fields: [organisationId, ownerMembershipId], references: [organisationId, id], onDelete: Restrict)
  priority       ItemPriority?
  evidenceLinks  AssessmentItemEvidence[]
  tasks          RemediationTask[]

  @@unique([organisationId, id])
  @@index([organisationId, assessmentId])
  @@index([organisationId, businessUnitId])
  @@index([organisationId, frameworkId])
  @@map("assessment_items")
}

/// The Eisenhower triage of one item: the saved ANSWERS and the ruleset version, plus an authorised person's
/// adjustment with its reason. Urgency, importance and the quadrant are derived on every read from these, so a
/// quadrant never exists without its criteria. Mutable even after the assessment is approved (it is triage,
/// not scoring); every change is audited.
model ItemPriority {
  id                String    @id @default(uuid(7)) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  assessmentItemId  String    @map("assessment_item_id") @db.Uuid
  /// { question_key: true | false }; a missing key is NOT ANSWERED, never "No".
  answers           Json
  rulesetVersion    Int       @map("ruleset_version")
  urgentOverride    Boolean?  @map("urgent_override")
  importantOverride Boolean?  @map("important_override")
  overrideReason    String?   @map("override_reason")
  adjustedByUserId  String?   @map("adjusted_by_user_id") @db.Uuid
  adjustedAt        DateTime? @map("adjusted_at") @db.Timestamptz
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  item         AssessmentItem @relation(fields: [organisationId, assessmentItemId], references: [organisationId, id], onDelete: Restrict)
  adjustedBy   User?          @relation("PriorityAdjustedBy", fields: [adjustedByUserId], references: [id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@unique([organisationId, assessmentItemId])
  @@map("item_priorities")
}

/// An organisation's scoring and scheduling policy. NULL columns mean "the reference defaults". One row per
/// organisation, created when it first changes something.
model AssessmentPolicy {
  id                 String   @id @default(uuid(7)) @db.Uuid
  organisationId     String   @unique @map("organisation_id") @db.Uuid
  /// { lowMax, mediumMax, highMax } for exposure_v1, or null for the reference bands.
  exposureThresholds Json?    @map("exposure_thresholds")
  /// { CRITICAL, HIGH, MEDIUM, LOW } days until a new task is due, or null for the reference defaults.
  remediationDueDays Json?    @map("remediation_due_days")
  /// { minDays, maxDays } scheduling window of the Plan quadrant, or null for the reference default.
  planWindowDays     Json?    @map("plan_window_days")
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@map("assessment_policies")
}

/// A task that fixes a finding. The subject columns copy what the task is about (so an open task is found again
/// across assessment revisions); the snapshot columns freeze the maturity and risk it was raised for.
model RemediationTask {
  id                      String       @id @default(uuid(7)) @db.Uuid
  organisationId          String       @map("organisation_id") @db.Uuid
  assessmentItemId        String?      @map("assessment_item_id") @db.Uuid
  governanceAreaId        String?      @map("governance_area_id") @db.Uuid
  requirementId           String?      @map("requirement_id") @db.Uuid
  businessUnitId          String?      @map("business_unit_id") @db.Uuid
  frameworkId             String?      @map("framework_id") @db.Uuid
  title                   String
  description             String?
  priority                TaskPriority
  status                  TaskStatus   @default(OPEN)
  assigneeMembershipId    String?      @map("assignee_membership_id") @db.Uuid
  dueDate                 DateTime?    @map("due_date") @db.Date
  autoGenerated           Boolean      @default(false) @map("auto_generated")
  snapshotCurrentMaturity Int?         @map("snapshot_current_maturity") @db.SmallInt
  snapshotTargetMaturity  Int?         @map("snapshot_target_maturity") @db.SmallInt
  snapshotGap             Int?         @map("snapshot_gap") @db.SmallInt
  snapshotRiskLevel       RiskLevel?   @map("snapshot_risk_level")
  createdByUserId         String       @map("created_by_user_id") @db.Uuid
  completedAt             DateTime?    @map("completed_at") @db.Timestamptz
  completedByUserId       String?      @map("completed_by_user_id") @db.Uuid
  verifiedAt              DateTime?    @map("verified_at") @db.Timestamptz
  verifiedByUserId        String?      @map("verified_by_user_id") @db.Uuid
  version                 Int          @default(1)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organisation   Organisation              @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  item           AssessmentItem?           @relation(fields: [organisationId, assessmentItemId], references: [organisationId, id], onDelete: Restrict)
  governanceArea GovernanceArea?           @relation(fields: [organisationId, governanceAreaId], references: [organisationId, id], onDelete: Restrict)
  requirement    Requirement?              @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  businessUnit   BusinessUnit?             @relation(fields: [organisationId, businessUnitId], references: [organisationId, id], onDelete: Restrict)
  framework      Framework?                @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  assignee       Membership?               @relation("TaskAssignee", fields: [organisationId, assigneeMembershipId], references: [organisationId, id], onDelete: Restrict)
  createdBy      User                      @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  completedBy    User?                     @relation("TaskCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)
  verifiedBy     User?                     @relation("TaskVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: Restrict)
  events         RemediationTaskEvent[]
  evidenceLinks  RemediationTaskEvidence[]

  @@unique([organisationId, id])
  @@index([organisationId, status])
  @@index([organisationId, assigneeMembershipId])
  @@index([organisationId, assessmentItemId])
  @@map("remediation_tasks")
}

/// The append-only timeline of a task: comments, status changes (with the reason when reopening) and
/// reassignments. The database rejects UPDATE and DELETE (trigger in the migration).
model RemediationTaskEvent {
  id             String        @id @default(uuid(7)) @db.Uuid
  organisationId String        @map("organisation_id") @db.Uuid
  taskId         String        @map("task_id") @db.Uuid
  kind           TaskEventKind
  fromStatus     TaskStatus?   @map("from_status")
  toStatus       TaskStatus?   @map("to_status")
  body           String?
  actorUserId    String        @map("actor_user_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  task         RemediationTask @relation(fields: [organisationId, taskId], references: [organisationId, id], onDelete: Restrict)
  actor        User            @relation("TaskEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, taskId])
  @@map("remediation_task_events")
}

/// An uploaded evidence file (core: upload, metadata, checksum, download, links). The bytes live in storage under
/// an opaque key; the original filename lives only here. Versions, review and legal hold arrive in Phase 7.
model Evidence {
  id               String   @id @default(uuid(7)) @db.Uuid
  organisationId   String   @map("organisation_id") @db.Uuid
  title            String
  description      String?
  originalFilename String   @map("original_filename")
  contentType      String   @map("content_type")
  size             Int
  /// SHA-256 (hex) computed by the server from the stored bytes.
  sha256           String
  storageKey       String   @map("storage_key")
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organisation Organisation              @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  uploadedBy   User                      @relation("EvidenceUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  itemLinks    AssessmentItemEvidence[]
  taskLinks    RemediationTaskEvidence[]

  @@unique([organisationId, id])
  @@index([organisationId, createdAt])
  @@map("evidence")
}

model AssessmentItemEvidence {
  id               String   @id @default(uuid(7)) @db.Uuid
  organisationId   String   @map("organisation_id") @db.Uuid
  assessmentItemId String   @map("assessment_item_id") @db.Uuid
  evidenceId       String   @map("evidence_id") @db.Uuid
  linkedByUserId   String   @map("linked_by_user_id") @db.Uuid
  linkedAt         DateTime @default(now()) @map("linked_at") @db.Timestamptz

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  item         AssessmentItem @relation(fields: [organisationId, assessmentItemId], references: [organisationId, id], onDelete: Restrict)
  evidence     Evidence       @relation(fields: [organisationId, evidenceId], references: [organisationId, id], onDelete: Restrict)
  linkedBy     User           @relation("ItemEvidenceLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)

  @@unique([organisationId, assessmentItemId, evidenceId])
  @@index([organisationId, evidenceId])
  @@map("assessment_item_evidence")
}

model RemediationTaskEvidence {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  evidenceId     String   @map("evidence_id") @db.Uuid
  linkedByUserId String   @map("linked_by_user_id") @db.Uuid
  linkedAt       DateTime @default(now()) @map("linked_at") @db.Timestamptz

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  task         RemediationTask @relation(fields: [organisationId, taskId], references: [organisationId, id], onDelete: Restrict)
  evidence     Evidence        @relation(fields: [organisationId, evidenceId], references: [organisationId, id], onDelete: Restrict)
  linkedBy     User            @relation("TaskEvidenceLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)

  @@unique([organisationId, taskId, evidenceId])
  @@index([organisationId, evidenceId])
  @@map("remediation_task_evidence")
}

/// A generated report: a stored PDF with the parameters, the data snapshot and the versions it was built from,
/// so it can be reproduced and audited. Generation is synchronous in Phase 5 (rows are READY); the status column
/// exists for the asynchronous catalogue of Phase 9a.
model Report {
  id                String       @id @default(uuid(7)) @db.Uuid
  organisationId    String       @map("organisation_id") @db.Uuid
  template          String
  title             String
  assessmentId      String?      @map("assessment_id") @db.Uuid
  params            Json
  status            ReportStatus @default(READY)
  /// The numbers and rows the PDF was drawn from, plus the methodology and band snapshot.
  dataSnapshot      Json         @map("data_snapshot")
  storageKey        String       @map("storage_key")
  sha256            String
  size              Int
  requestedByUserId String       @map("requested_by_user_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  assessment   Assessment?  @relation(fields: [organisationId, assessmentId], references: [organisationId, id], onDelete: Restrict)
  requestedBy  User         @relation("ReportRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, createdAt])
  @@map("reports")
}
