{
  "name": "fca-backend",
  "version": "0.1.0",
  "description": "Fernando Compliance Accelerator (FCA) - REST API (NestJS + PostgreSQL on Neon)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src test scripts prisma.config.ts",
    "format": "prettier --write \"{src,test,scripts}/**/*.{ts,mjs}\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.{ts,mjs}\" \"*.{ts,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:int": "vitest run --config ./vitest.config.int.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "openapi:export": "nest build && node dist/cli/export-openapi.js",
    "openapi:check": "node dist/cli/export-openapi.js --check",
    "check:docs": "node scripts/check-docs.mjs",
    "postinstall": "prisma generate",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:e2e && npm run build && npm run openapi:check && npm run check:docs",
    "verify:full": "npm run verify && npm run test:int",
    "db:apply-runtime-role": "node scripts/db-apply-sql.mjs prisma/sql/runtime-role.sql",
    "platform-admin": "node scripts/platform-admin.mjs",
    "seed:dev": "node scripts/seed-dev.mjs",
    "frameworks:status": "node scripts/frameworks/cli.mjs status",
    "frameworks:extract": "node scripts/frameworks/cli.mjs extract",
    "frameworks:verify": "node scripts/frameworks/cli.mjs verify",
    "frameworks:load": "node scripts/frameworks/cli.mjs load"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.7",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "pdfmake": "0.3.11",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pdfmake": "0.2.13",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "prisma": "7.10.0",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "@scarf/scarf": false
  }
}
