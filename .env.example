# fca-backend environment. Copy to `.env` (git-ignored) and fill in. NEVER commit real values and
# never paste connection strings into chat, tickets or commits.
#
# Legend:  KEY=...   is validated/read by the application today.
#          # KEY=... is RESERVED for a later phase (documented now so nothing is invented later).
# `npm run check:docs` verifies every key in src/config/env.schema.ts appears here.

# ---------------------------------------------------------------- Runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Comma-separated EXACT browser origins allowed by CORS (no wildcards, no paths).
CORS_ORIGINS=http://localhost:5173
# Serve Swagger UI at /api/docs. Defaults to true outside production.
SWAGGER_ENABLED=true

# ---------------------------------------------------------------- Database (Neon) - see docs/neon-setup.md
# POOLED connection string (host contains "-pooler") used by the running app via @prisma/adapter-pg.
# Leave empty to run without a database: /api/v1/health/ready then reports DATABASE_NOT_CONFIGURED.
DATABASE_URL=
DATABASE_POOL_MAX=10
# Neon compute can take a few seconds to wake from scale-to-zero.
DATABASE_CONNECT_TIMEOUT_MS=10000
# Which addresses to try first when a hostname has IPv4 and IPv6 (verbatim | ipv4first | ipv6first), and how
# long each gets before the next. The defaults avoid ~22 s connection stalls where IPv6 is not routed.
DNS_RESULT_ORDER=ipv4first
NET_ATTEMPT_TIMEOUT_MS=2000
# Longest a single unit-of-work transaction may run (keep transactions short behind the Neon pooler).
DATABASE_TRANSACTION_TIMEOUT_MS=10000
# DIRECT (non-pooled) connection string used ONLY by the Prisma CLI (prisma.config.ts) for migrations.
DIRECT_URL=

# Integration tests (Phase 2a) run against the Neon `test` branch and are DESTRUCTIVE.
# The test bootstrap refuses to run unless the database name contains "test".
# TEST_DATABASE_URL=
# TEST_DIRECT_URL=
# ALLOW_DESTRUCTIVE_TESTS=false

# ---------------------------------------------------------------- Auth (Phase 2b)
# REQUIRED. Signs access tokens (and derives the keyed hash of lockout counters). At least 32 random
# characters, unique per environment, never committed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
# Absolute lifetime of a login; the refresh token is rotated on every use within it.
REFRESH_TOKEN_TTL_DAYS=30
# A rotated refresh token presented again within this many seconds is a concurrent request (several tabs
# restoring), not theft. Later reuse revokes the whole session. 0 disables the grace.
REFRESH_REUSE_GRACE_SECONDS=10
# Origin of the web app: the base of every link in an email.
APP_BASE_URL=http://localhost:5173
# Refresh-token cookie. COOKIE_DOMAIN only when web and API share a registrable domain (gate G0).
COOKIE_DOMAIN=
# Empty = true in production and false elsewhere (set false only for plain http outside localhost).
COOKIE_SECURE=
# Reverse-proxy hops to trust for the client IP (0 = none). A wrong value makes IP limits spoofable.
TRUST_PROXY=0
# Coarse per-IP requests per minute (auth routes have their own stricter limit). THROTTLE_ENABLED defaults to true.
THROTTLE_LIMIT=120
# Empty = true. Set false only for load tests.
THROTTLE_ENABLED=
# true = any signed-in user may create an organisation and becomes its Owner (POST /organisations).
# Empty/false = only a platform administrator provisions organisations (the default; gate G0 decides production).
ORGANISATIONS_SELF_SERVE=
# argon2id cost (OWASP minimum: 19456 KiB with time cost 2).
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

# ---------------------------------------------------------------- Email (Phase 2b)
# file = write .eml files to DEV_MAIL_DIR and log the link (development/tests: NOTHING is delivered).
# A real provider (SMTP/ESP) is chosen at gate G0 and added then; until then production cannot send mail.
MAIL_TRANSPORT=file
MAIL_FROM="Fernando Compliance Accelerator <no-reply@fca.localhost>"
DEV_MAIL_DIR=.dev-mail
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ---------------------------------------------------------------- File storage
# local = the disk under STORAGE_LOCAL_DIR (git-ignored); s3 = an S3-compatible object store.
# Empty = local outside production, s3 in production: a host that can discard the instance's disk cannot keep
# uploaded files on it (ADR-0007).
STORAGE_DRIVER=
STORAGE_LOCAL_DIR=.local-storage
# Required when STORAGE_DRIVER=s3. Supabase Storage speaks the S3 protocol, so its endpoint works here as
# configuration: https://<project-ref>.storage.supabase.co with the project's region, and a bucket plus an
# S3 access key created in that project. Nothing in the app is public: bytes reach a browser only through the
# authorised download endpoints, so the bucket stays private.
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# A Supabase (and MinIO) S3 endpoint addresses a bucket as <endpoint>/<bucket>/<key>, not <bucket>.<endpoint>.
STORAGE_S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------- Uploads
# The largest evidence file the API accepts, in bytes. It must stay under the request body limit of whatever
# hosts the API (Vercel functions take 4.5 MB in and out), and the API states it on GET /api/v1/meta so no
# client has to guess. Default 4194304 (4 MiB).
EVIDENCE_MAX_BYTES=4194304

# ---------------------------------------------------------------- Background jobs (Phase 2b)
# inproc = poller inside the API process (default in development; keeps Neon compute awake);
# external = host cron calls POST /api/v1/internal/jobs/tick (default elsewhere).
# Empty = inproc in development, external elsewhere.
JOBS_RUNNER=
# HMAC secret (>= 32 chars) that signs calls to the tick endpoint. Empty = the endpoint is disabled (404).
JOBS_TICK_SECRET=
JOBS_POLL_INTERVAL_MS=5000
JOBS_BATCH_SIZE=10
JOBS_LEASE_SECONDS=60
