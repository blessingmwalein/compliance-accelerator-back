{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "functions": {
    "api/index.mjs": {
      "memory": 1024,
      "maxDuration": 300,
      "includeFiles": "../node_modules/@prisma/client/runtime/*"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
